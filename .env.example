# ──────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ──────────────────────────────────────────────
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=school_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ──────────────────────────────────────────────
# Backend
# ──────────────────────────────────────────────
SECRET_KEY=generate-a-secure-random-key-here
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ──────────────────────────────────────────────
# Admin authentication
# ──────────────────────────────────────────────
# bcrypt hash of the admin password (never the plaintext)
ADMIN_PASSWORD_HASH=
# Optional legacy X-API-Key credential
ADMIN_API_KEY=

# ──────────────────────────────────────────────
# LLM Providers (OpenRouter, OpenAI-compatible)
# ──────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_LLM_MODEL=google/gemini-2.5-flash

# ──────────────────────────────────────────────
# Embeddings
# ──────────────────────────────────────────────
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ──────────────────────────────────────────────
# Retrieval
# ──────────────────────────────────────────────
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.70

# ──────────────────────────────────────────────
# Rate limiting (per client IP)
# ──────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Stricter throttle for admin login attempts
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# ──────────────────────────────────────────────
# Caching (Redis)
# ──────────────────────────────────────────────
CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=2592000
RESPONSE_CACHE_TTL_SECONDS=900

# ──────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────
# Backend *origin* only — the /api/v1 prefix is appended by the client.
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
