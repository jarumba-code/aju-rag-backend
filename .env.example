# ──────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ──────────────────────────────────────────────
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=school_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ──────────────────────────────────────────────
# Backend
# ──────────────────────────────────────────────
SECRET_KEY=generate-a-secure-random-key-here
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Required by the admin endpoints (X-API-Key header) — leave blank to disable
# admin routes entirely (they will return 401 for every request).
ADMIN_API_KEY=generate-a-secure-admin-key-here
# Admin password authentication (preferred).
# Generate a strong bcrypt hash and store it here. Example generation:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YourStrongPassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,https://arthurjarvisuniversity.edu.ng

# ──────────────────────────────────────────────
# LLM Providers
# ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────
# Embeddings
# ──────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ──────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────
# The backend ORIGIN (no path). The frontend API client appends /api/v1 itself,
# so "http://localhost:8000/api/v1" would also work but is not recommended.
NEXT_PUBLIC_API_URL=http://localhost:8000
