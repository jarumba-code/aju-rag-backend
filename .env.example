# ─────────────────────────────────────────────────────────────────────────────
# AJU RAG — environment template (single-container image: aju-rag)
#
# Usage:
#   cp .env.example .env        # then fill in the CHANGE-ME values
#   docker run -p 3000:3000 -p 8000:8000 --env-file .env \
#     -v aju-pgdata:/var/lib/postgresql/data -v aju-redis:/data/redis aju-rag
#
# RULES:
# - NEVER commit the real .env (it is gitignored). Only .env.example is tracked.
# - NEVER bake secrets into the Docker image. This file is NOT copied into it;
#   values are injected at `docker run` time via --env-file / -e.
# - Variables marked REQUIRED must be set to non-default values in production.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database: PostgreSQL 16 + pgvector (runs INSIDE the container) ──────────
# The container bootstraps this role/database on first start and enables the
# `vector` extension. Defaults match backend/src/config.py + docker-compose.
POSTGRES_USER=rag_user
# REQUIRED: set a strong password. Must match on every restart for the same
# volume (it is only applied when the data volume is first initialised).
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=school_rag
# Keep these as localhost inside the single container (services share loopback).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional full override. If empty, the backend builds it from POSTGRES_* above.
# When set, use the asyncpg driver scheme, e.g.:
# DATABASE_URL=postgresql+asyncpg://rag_user:SECRET@localhost:5432/school_rag
DATABASE_URL=
# Data directory inside the container (backed by the aju-pgdata volume).
# You normally do NOT need to change this.
PGDATA=/var/lib/postgresql/data

# ─── Redis 7 (runs INSIDE the container, loopback only) ──────────────────────
# NOTE: the current backend code does not yet issue Redis commands (rate-limit
# and cache hooks are stubs; only TTL defaults are seeded). Redis is still run
# and persisted so caching/rate-limiting can be enabled without re-architecting.
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional full override, e.g. REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ─── Backend: FastAPI ────────────────────────────────────────────────────────
# REQUIRED: long random string used to sign admin JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=generate-a-secure-random-key-here
# REQUIRED (one of the two): bcrypt hash of the admin password (never the
# plaintext password). Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
# The running backend also accepts a DB-stored hash (system_settings row
# `admin_password_hash`), which takes precedence once set via the API.
ADMIN_PASSWORD_HASH=
# Legacy/static admin key accepted alongside JWTs (X-API-Key header).
# REQUIRED in production if any automation uses it; leave empty to disable.
ADMIN_API_KEY=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Listen address/port INSIDE the container. Keep 0.0.0.0:8000 (only port 8000
# is published to the host; the DB/cache stay on loopback regardless).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─── LLM provider: OpenRouter (REQUIRED for answers + embeddings) ────────────
# The RAG pipeline calls OpenRouter for BOTH chat completions and embeddings.
# Without this key, retrieval runs but answers fall back to error messages.
# REQUIRED: create at https://openrouter.ai/
OPENROUTER_API_KEY=
# Declared for completeness: backend/src/config.py defines it, but the
# services currently use https://openrouter.ai/api/v1 directly.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chat model used by src/services/llm.py (overrides code default).
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Default chat model name kept in config (currently informational only).
DEFAULT_LLM_MODEL=google/gemini-2.5-flash
# HTTP timeout (seconds) for LLM requests.
LLM_TIMEOUT_SECONDS=45

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Model MUST produce 1536-dim vectors (matches the pgvector Vector(1536)
# column in src/models.py). Changing dimension requires a code + DB migration.
EMBEDDING_MODEL=openai/text-embedding-3-small
# Declared for completeness: informational only, the dimension is fixed at
# 1536 in code. Do not change without migrating the vector column.
EMBEDDING_DIMENSION=1536

# ─── Retrieval tuning (optional) ─────────────────────────────────────────────
# Top-K chunks per query and minimum cosine-similarity threshold.
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.70

# ─── Frontend: Next.js ───────────────────────────────────────────────────────
# Public API origin used by BOTH the browser bundle and the Next.js API-route
# proxies. For `docker run -p 3000:3000 -p 8000:8000` on the same machine,
# keep http://localhost:8000. IMPORTANT: this value is inlined into the client
# bundle at IMAGE BUILD time, so a different public URL requires rebuilding:
#   docker build --build-arg NEXT_PUBLIC_API_URL=https://api.example.com -t aju-rag .
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Port the Next.js standalone server listens on inside the container.
FRONTEND_PORT=3000
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# ─── Reserved / not read by current code ─────────────────────────────────────
# Kept so operators coming from the old example are not surprised. The backend
# reads OPENROUTER_API_KEY (above), NOT these provider-specific keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
